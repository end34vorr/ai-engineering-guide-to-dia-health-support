digraph G {
  rankdir=LR; fontname="Helvetica"; labelloc=t; fontsize=20; nodesep=0.4; ranksep=0.65; pad=0.4;
  label="Guide to Dia — V1 Conceptual Architecture, detailed view (labelled by function, not technology)";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.18,0.12"];
  edge [fontname="Helvetica", fontsize=10, color="#444444"];

  user  [label="User\n(young adult, 18–35)", fillcolor="#E0E0E0"];
  ui    [label="Application Interface\nbaseline form, weekly check-in,\nprogress dashboard, coach chat\n(FR1, FR4, FR11, FR12)", fillcolor="#E0E0E0"];
  in_ctl [label="Input Scope / Safety Control\nout-of-scope, red-flag symptoms,\neating-disorder signals, identifiers\n(FR9, FR10, RAI1, RAI3, RAI7)", fillcolor="#FFD9A8"];
  calc  [label="Rule-based Risk Calculator\npublished scoring table, deterministic\n(FR2, NFR3)", fillcolor="#BBD7F5"];
  goal  [label="Goal & Progress Engine (rules)\nstarting goals from guidance;\nprogress, streaks, trends computed by code\n(FR3, FR5, NFR3)", fillcolor="#BBD7F5"];
  store [label="On-device Tracker Store\ncheck-ins, goals, score history;\nexport / delete\n(FR4, FR12, RAI3)", fillcolor="#C8E6C9"];
  path  [label="Malaysian Pathway Selector (rules)\nrisk band + age band + optional\nSTR status → where to test\n(FR8, RAI6)", fillcolor="#BBD7F5"];
  prep  [label="Data Preparation\nextract → clean → chunk\nper page + lineage\n(Week 3 pipeline)", fillcolor="#C8E6C9"];
  kb    [label="Knowledge Source\nMoH CPG, Malaysian Dietary Guidelines,\nWHO, ProtectHealth / MyGov pages\n+ source metadata and dates", fillcolor="#C8E6C9"];
  ret   [label="Knowledge Access\nfind passages for the user's\nprogress, question or pathway\n(FR3, FR6–FR8, NFR2, NFR8)", fillcolor="#BBD7F5"];
  coach [label="AI Coach (language model)\nweekly recap, one small next action,\nanswers questions, from passages only\n(FR6, FR7, NFR4)", fillcolor="#BBD7F5"];
  out_ctl [label="Output Safety / Citation Control\ncitations present and supporting,\nno diagnosis / diet plan / outcome claims,\nsupportive tone\n(FR7, RAI1, RAI2, RAI5, RAI7, RAI8)", fillcolor="#FFD9A8"];
  resp  [label="Response\nprogress, plain explanation, citations,\nONE small next action, disclaimer,\nwhere to test when triggered", fillcolor="#E0E0E0"];
  eval  [label="Evaluation Point\ncurated test sets, latency log,\nfeedback (no identifiers)", fillcolor="#D9C7F0"];

  user -> ui [label="answers /\ncheck-ins"];
  ui -> in_ctl [label="user input"];
  in_ctl -> calc [label="validated\nbaseline"];
  in_ctl -> store [label="validated\ncheck-in"];
  in_ctl -> resp [label="refuse / redirect", style=dashed, color="#C0392B", fontcolor="#C0392B"];
  calc -> goal [label="risk band"];
  store -> goal [label="records"];
  goal -> store [label="goals,\nprogress"];
  calc -> path [label="band + age +\nSTR flag"];
  prep -> kb [label="prepared chunks"];
  kb -> ret [label="documents"];
  goal -> ret [label="derived summary\n(no raw logs)"];
  path -> ret [label="pathway ID"];
  ret -> coach [label="passages +\nsource IDs"];
  goal -> coach [label="progress (read-only)"];
  coach -> out_ctl [label="draft"];
  out_ctl -> coach [label="reject → retry once /\nfallback text", style=dashed, color="#C0392B", fontcolor="#C0392B"];
  out_ctl -> resp [label="approved text"];
  resp -> ui [label="display"];
  ui -> user [label="result"];
  out_ctl -> eval [style=dotted, label="logs"];
  coach -> eval [style=dotted, label="latency"];

  subgraph cluster_legend { label="Colour key"; fontsize=11; style="rounded"; color="#999999";
    l1 [label="Data / storage / pipeline", fillcolor="#C8E6C9", fontsize=10];
    l2 [label="Model / AI / rules", fillcolor="#BBD7F5", fontsize=10];
    l3 [label="Guardrails & safety", fillcolor="#FFD9A8", fontsize=10];
    l4 [label="Evaluation & monitoring", fillcolor="#D9C7F0", fontsize=10];
    l5 [label="User interface", fillcolor="#E0E0E0", fontsize=10];
    l1 -> l2 -> l3 -> l4 -> l5 [style=invis];
  }
}
